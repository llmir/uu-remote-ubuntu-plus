runtime_files+=(vendor/freerdp-input-sdk/manifest.json vendor/freerdp-input-sdk/LICENSE vendor/freerdp-input-sdk/README.md)
while IFS= read -r sdk_header; do
    runtime_files+=("$sdk_header")
done < <(find vendor/freerdp-input-sdk/include -type f -print | LC_ALL=C sort)
release_manifests=(patches/uu-remote-*.json)

sha256sum "${runtime_files[@]}" "${release_manifests[@]}" | \
    sha256sum | awk '{print $1}'
