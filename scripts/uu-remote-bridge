        freerdp_mouse_options+=(/mouse:relative:off,grab:off)
    fi
    /opt/wine-stable/bin/wine "$freerdp_exe" \
        "/v:127.0.0.1:$rdp_port" \
        "/u:$bridge_user" \
        /from-stdin:force \
        "$cert_option" \
        /sspi-module:'C:\Program Files\FreeRDP\winpr-sspi-shim.dll' \
        /auth-pkg-list:'none,ntlm' \
        /network:auto \
        "/size:$resolution" \
        /smart-sizing:on \
        /bpp:32 \
        /gdi:sw \
        /audio-mode:2 \
        "${freerdp_mouse_options[@]}" \
        "${freerdp_full_options[@]}" \
        /prevent-session-lock:180 \
        /t:Ubuntu-Desktop-Relay \
        +f \
        -toggle-fullscreen \
        -decorations \
        -suppress-output \
        "$freerdp_clipboard_option" \
        +auto-reconnect \
        /auto-reconnect-max-retries:0 \
        /log-level:WARN \
        <<<"$password" >>"$state_dir/freerdp.log" 2>&1 &
    freerdp_pid=$!
    unset password

    for _ in {1..300}; do
        if /usr/bin/xdotool search --name Ubuntu-Desktop-Relay \
            >/dev/null 2>&1; then
            relay_ready=true
            break
        fi
        # Wine's Unix launcher may exit after handing the Windows process to
        # wineserver. Its lifetime does not represent the client lifetime.
        sleep 0.1
    done
    if [[ "$relay_ready" != true ]]; then
        log 'FreeRDP did not create the Ubuntu desktop relay window.'
        exit 1
    fi

    if [[ "$cursor_guard_setting" == on ]]; then
        rm -f "$cursor_guard_log"
        if ! /opt/wine-stable/bin/wine "$input_injector_exe" \
            "$cursor_guard_windows_path" sdl-freerdp.exe \
            >>"$state_dir/cursor-guard-injector.log" 2>&1; then
            log 'Could not inject the FreeRDP cursor guard.'
            preserve_cursor_guard_failure relay-injection || true
            exit 1
        fi
        cursor_guard_ready=false
        for _ in {1..100}; do
            if grep -q 'UU relay cursor guard active' \
                "$cursor_guard_log" 2>/dev/null; then
                cursor_guard_ready=true
                break
            fi
            if grep -q 'UU cursor guard initialization failed' \
                "$cursor_guard_log" 2>/dev/null; then
                break
            fi
            sleep 0.05
        done
        if [[ "$cursor_guard_ready" != true ]]; then
            log 'The FreeRDP cursor guard did not initialize.'
            preserve_cursor_guard_failure relay-readiness || true
            exit 1
        fi
    fi

    relay_window_id="$(
        /usr/bin/xdotool search --onlyvisible \
            --name '^Ubuntu-Desktop-Relay$' 2>/dev/null \
            | /usr/bin/tail -n 1
    )"
else
    desktop_vnc_display=$((desktop_vnc_port - 5900))
    /usr/bin/env \
        DBUS_SESSION_BUS_ADDRESS=unix:path=/dev/null \
        /usr/bin/vncviewer \
        -AllowMainClose=1 \
        -LogToAddressBook=0 \
        -FullScreen=1 \
        -FullScreenHint=1 \
        -EnableToolbar=0 \
        -AcceptBell=0 \
        -AudioVolume=0 \
        -WarnUnencrypted=0 \
        -VerifyId=0 \
        -Shared=1 \
        -Scaling=Fit \
        -DynamicResolution=0 \
        -GrabKeyboard="$vnc_grab_keyboard_value" \
        -SendKeyEvents=1 \
        -SendPointerEvents=1 \
        -ClientCutText=1 \
        -ServerCutText=0 \
        -SendPrimary=0 \
        -SendInitialClipboard=0 \
        -ServerClipboardGraceTime=5000 \
        -MenuKey= \
        -UpdateScreenshot=0 \
        -ShowSplash=0 \
        -EnableAnalytics=0 \
        -ShareFiles=0 \
        -EnableRemotePrinting=0 \
        -ChangeServerDefaultPrinter=0 \
        "127.0.0.1:$desktop_vnc_display" \
        >>"$state_dir/vncviewer-relay.log" 2>&1 &
    vncviewer_pid=$!

    for _ in {1..300}; do
        relay_window_id="$(
            {
                /usr/bin/xdotool search --onlyvisible \
                    --pid "$vncviewer_pid" \
                    --name '^127\.0\.0\.1:.* - RealVNC Viewer$' \
                    2>/dev/null || true
            } | /usr/bin/tail -n 1
        )"
        if [[ -n "$relay_window_id" ]]; then
            relay_ready=true
            break
        fi
        if ! kill -0 "$vncviewer_pid" >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
    if [[ "$relay_ready" != true ]]; then
        log 'The VNC viewer did not create the Ubuntu desktop relay window.'
        exit 1
    fi
fi

if [[ -z "$relay_window_id" ]]; then
    log 'Could not identify the Ubuntu desktop relay window.'
    exit 1
fi
if [[ "$input_route" == rdp-public ]]; then
    sdl_windows_exe="$(/opt/wine-stable/bin/winepath -w "$freerdp_exe")"
    sdl_ready_identity="$(/usr/bin/python3 "$full_ready_helper" \
        --ready "$full_ready_dir/sdl.ready" --nonce "$full_nonce" --role sdl \
        --exe "$freerdp_exe" --exe-windows "$sdl_windows_exe" \
        --prefix "$WINEPREFIX" --display "$DISPLAY" --parent "$$" \
        --output "$full_session_dir/sdl-bound.json" --timeout 15)" || exit 1
    read -r sdl_windows_pid sdl_windows_start full_sdl_linux_pid full_sdl_linux_start <<<"$sdl_ready_identity"
    manual_active=false
    for _ in {1..100}; do
        if /usr/bin/python3 "$manual_plane_helper" --check-ready \
            --display "$DISPLAY" --prefix "$WINEPREFIX" --parent "$$" \
            --ready "$manual_plane_ready" >/dev/null 2>&1; then
            manual_active=true; break
        fi
        [[ ! -e "$manual_plane_ready.failure" ]] || break
        kill -0 "$manual_plane_pid" 2>/dev/null || break
        sleep .05
    done
    [[ "$manual_active" == true ]] || { log 'Manual owner did not bind actual SDL viewport.'; exit 1; }
    # One read-only probe before the UU physical DLL takes the single broker
    # pipe. Never probe it periodically while that long-lived client owns it.
    if ! /usr/bin/timeout --kill-after=1s 5s /opt/wine-stable/bin/wine \
        "$input_broker_probe_exe" >>"$state_dir/full-input-probe.log" 2>&1; then
        log 'Actual public RDP input capabilities/configuration are not ready.'
        exit 1
    fi
    # The strict DLL-directory current-session config avoids assuming SCM
    # environment inheritance. Fresh actual hooks log is still mandatory.
    /usr/bin/python3 "$full_ready_helper" --fresh-public-log \
        --prefix "$WINEPREFIX" --parent "$$" --nonce "$full_nonce" \
        --output "$public_input_log" --archive "$full_session_dir/input-hooks-before.log" || exit 1
    public_input_ready=true
    inject_input_bridge || exit 1
    public_hooks_active=false
    for _ in {1..100}; do
        if /usr/bin/grep -Eq 'UU public session config accepted; source PID=[1-9][0-9]* FILETIME=[1-9][0-9]*' \
                "$public_input_log" 2>/dev/null &&
           /usr/bin/grep -q 'UU public input LOCAL wrapper state hooks active' "$public_input_log" &&
           /usr/bin/grep -q 'UU SendInput bridge active' "$public_input_log" &&
           /usr/bin/grep -q 'UU Wine event-log compatibility active' "$public_input_log"; then
            public_hooks_active=true; break
        fi
        sleep .05
    done
    [[ "$public_hooks_active" == true ]] || {
        log 'Actual audited server did not activate the public input route; SCM environment/configuration is not proven.'
        exit 1
    }
else
    /usr/bin/xdotool windowactivate --sync "$relay_window_id" >/dev/null 2>&1 || true
fi

bootstrap_account() {
    /opt/wine-stable/bin/wine "$service_control_exe" \
        GameViewerService 133 \
        >>"$state_dir/service-control.log" 2>&1 || true
    LIBGL_ALWAYS_SOFTWARE=1 /opt/wine-stable/bin/wine start /unix "$uu_app_dir/GameViewer.exe" \
        >>"$state_dir/client-bootstrap.log" 2>&1 || true

    # Keep the layered Wine/Qt management window mapped. Minimizing it while
    # its top-level windows are still being replaced can raise BadWindow,
    # terminate the GUI IPC client, and make the server destroy its room.
    # The relay focus supervisor safely keeps this window behind the desktop.
    sleep 1
    if [[ "$input_route" != rdp-public ]]; then
        /usr/bin/xdotool windowactivate --sync "$relay_window_id" \
            >/dev/null 2>&1 || true
    fi
}

# UU's GUI sends the account-login IPC message that makes the background
# server visible to other devices. Let it exit normally: forcibly closing it
# also asks the server to exit.
bootstrap_account

supervise_server() {
    local last_pid="$1"
    local last_starttime=""
    local candidate
    local candidate_starttime
    local candidate_relay_window_id
    local current_default_interface
    local active_window_id
    local focus_checks=0
    local grd_fd_count
    local health_checks=0
    local missing_checks=0
    local network_route_checks=0
    local current_desktop_resolution
    local pending_resolution=""
    local pending_resolution_checks=0
    local resolution_checks=0
    local resolution_grace_checks=240
    local monitor_checks=0
    local monitor_transition_checks=0
    local current_monitor_state
    local current_monitor_mode
    local expected_monitor_mode

    if wine_process_identity "$last_pid"; then
        last_starttime="$wine_process_starttime"
    fi
    while true; do
        if [[ "$input_route" == rdp-public ]] &&
           { [[ -e "$manual_plane_ready.failure" ]] || ! kill -0 "$manual_plane_pid" 2>/dev/null; }; then
            log 'Manual desktop owner failed; restarting the complete protected bridge.'
            return 1
        fi
        candidate=""
        candidate_starttime=""
        if [[ -n "$last_starttime" ]] && wine_process_identity "$last_pid" &&
           [[ "$wine_process_starttime" == "$last_starttime" ]]; then
            candidate="$last_pid"
            candidate_starttime="$last_starttime"
        else
            candidate="$(wine_prefix_process_pid 'GameViewerServer\.exe' || true)"
            if [[ -n "$candidate" ]] && wine_process_identity "$candidate"; then
                candidate_starttime="$wine_process_starttime"
            else
                candidate=""
            fi
        fi
        if [[ -z "$candidate" ]]; then
            missing_checks=$((missing_checks + 1))
            if ((missing_checks >= 40)); then
                log 'UU server was absent for 10 seconds; restarting the bridge.'
                return 1
            fi
        else
            missing_checks=0
        fi
        if [[ -n "$candidate" && ( "$candidate" != "$last_pid" ||
              "$candidate_starttime" != "$last_starttime" ) ]]; then
            sleep 0.25
            if initialize_server_compatibility; then
                last_pid="$candidate"
                last_starttime="$candidate_starttime"
                log "Re-injected UU server process $candidate."
                bootstrap_account
            else
                log "Could not re-inject UU server process $candidate."
                return 1
            fi
        fi
        focus_checks=$((focus_checks + 1))
        if ((focus_checks >= 4)); then
            focus_checks=0
            if [[ "$input_route" == rdp-public ]] &&
               ! /usr/bin/python3 "$manual_plane_helper" --check-ready \
                    --display "$DISPLAY" --prefix "$WINEPREFIX" --parent "$$" \
                    --ready "$manual_plane_ready" >/dev/null 2>&1; then
                log 'Manual owner/SDL repaint lost readiness; restarting the complete bridge.'
                return 1
            fi
            # RealVNC may replace its initial top-level window when it enters
            # full-screen mode. Refresh the ID before focusing so an obsolete
            # startup ID cannot leave UU's management window over the relay.
            if [[ "$desktop_relay" == vnc ]]; then
                candidate_relay_window_id="$(
                    {
                        /usr/bin/xdotool search --onlyvisible \
                            --pid "$vncviewer_pid" \
                            --name '^127\.0\.0\.1:.* - RealVNC Viewer$' \
                            2>/dev/null || true
                    } | /usr/bin/tail -n 1
                )"
                if [[ -n "$candidate_relay_window_id" ]]; then
                    relay_window_id="$candidate_relay_window_id"
                fi
            fi
            active_window_id="$(
                /usr/bin/xdotool getactivewindow 2>/dev/null || true
            )"
            if [[ "$input_route" != rdp-public && ! -e "$console_focus_file" && \
                  -n "$active_window_id" && \
                  "$active_window_id" != "$relay_window_id" ]]; then
                /usr/bin/xdotool windowactivate "$relay_window_id" \
                    >/dev/null 2>&1 || true
            fi
        fi
        health_checks=$((health_checks + 1))
        if ((grd_fd_restart_threshold > 0 && health_checks >= 40)); then
            health_checks=0
            if [[ -d "/proc/$grd_pid/fd" ]]; then
                grd_fd_count="$(
                    /usr/bin/find "/proc/$grd_pid/fd" -maxdepth 1 \
                        -type l -printf '.\n' 2>/dev/null | /usr/bin/wc -l
                )"
                if ((grd_fd_count >= grd_fd_restart_threshold)); then
                    log "GNOME Remote Desktop reached $grd_fd_count file descriptors; restarting the relay before exhaustion."
                    return 1
                fi
            fi
        fi
        if [[ "$network_interface" == default && \
              -n "$active_network_interface" ]]; then
            network_route_checks=$((network_route_checks + 1))
            if ((network_route_checks >= 40)); then
                network_route_checks=0
                current_default_interface="$(default_network_interface)"
                if [[ -n "$current_default_interface" && \
                      "$current_default_interface" != \
                      "$active_network_interface" ]]; then
                    log "Default network interface changed from $active_network_interface to $current_default_interface; restarting UU on the preferred route."
                    return 1
                fi
            fi
        fi
        if [[ "$follow_desktop_resolution" == on &&
              "$desktop_relay" == vnc ]]; then
            if ((resolution_grace_checks > 0)); then
                resolution_grace_checks=$((resolution_grace_checks - 1))
            else
                resolution_checks=$((resolution_checks + 1))
                if ((resolution_checks >= 20)); then
                    resolution_checks=0
                    current_desktop_resolution="$(desktop_geometry || true)"
                    if [[ -z "$current_desktop_resolution" ||
                          "$current_desktop_resolution" == "$resolution" ]]; then
                        pending_resolution=""
                        pending_resolution_checks=0
                    elif [[ "$current_desktop_resolution" == \
                            "$pending_resolution" ]]; then
                        pending_resolution_checks=$((
                            pending_resolution_checks + 1
                        ))
                    else
                        pending_resolution="$current_desktop_resolution"
                        pending_resolution_checks=1
                    fi
                    if ((pending_resolution_checks >= 3)); then
                        if ! persist_relay_resolution \
                            "$pending_resolution"; then
                            log 'Could not persist the stable desktop resolution; retaining the current canvas.'
                            pending_resolution=""
                            pending_resolution_checks=0
                        else
                            log "Desktop resolution remained stable at $pending_resolution; restarting only the UU bridge to align its canvas."
                            "${systemctl_user[@]}" --no-block restart \
                                "$service_name" >/dev/null 2>&1 || return 1
                            sleep 10
                            return 1
                        fi
                    fi
                fi
            fi
        fi
        if [[ "$desktop_monitor_watch" == true ]]; then
            monitor_checks=$((monitor_checks + 1))
            if ((monitor_checks >= 20)); then
                monitor_checks=0
                expected_monitor_mode="${monitor_fallback_value:-'mirror-primary'}"
                current_monitor_mode="$(/usr/bin/env \
                    DBUS_SESSION_BUS_ADDRESS="$desktop_bus" \
                    /usr/bin/gsettings get org.gnome.desktop.remote-desktop.rdp \
                    screen-share-mode 2>/dev/null || true)"
                if [[ -n "$current_monitor_mode" &&
                      "$current_monitor_mode" != "$expected_monitor_mode" ]]; then
                    desktop_monitor_watch=false
                    rm -f "$state_dir/monitor-fallback.mode"
                    log 'GNOME screen sharing mode was changed externally; retaining the user-selected mode.'
                fi
                if [[ "$desktop_monitor_watch" == true &&
                      "$current_monitor_mode" == "$expected_monitor_mode" ]]; then
                    current_monitor_state="$(physical_monitor_state)"
                else
                    current_monitor_state=unknown
                fi
                if [[ ( -n "$monitor_fallback_original" &&
                        "$current_monitor_state" == present ) ||
                      ( -z "$monitor_fallback_original" &&
                        "$current_monitor_state" == absent ) ]]; then
                    monitor_transition_checks=$((monitor_transition_checks + 1))
                else
                    monitor_transition_checks=0
                fi
                if ((monitor_transition_checks >= 2)); then
                    log "Physical monitor state is $current_monitor_state; requesting a planned bridge restart to switch the shared desktop."
                    if "${systemctl_user[@]}" --no-block restart \
                        "$service_name" >/dev/null 2>&1; then
                        # Stay alive until systemd delivers TERM. Returning here
                        # would report a planned transition as a child failure.
                        while true; do sleep 1; done
                    fi
                    log 'Could not request the planned monitor transition; retaining the current relay.'
                    monitor_transition_checks=0
                fi
            fi
        fi
        sleep 0.25
    done
}

supervise_server "$server_pid" &
server_supervisor_pid=$!

log "UU Remote and the $desktop_relay desktop relay share DISPLAY=$DISPLAY; physical keyboard route=$active_keyboard_route; semantic phone text helper=$([[ -n "$x11_input_port" ]] && printf active || printf unavailable); native clipboard=$([[ -n "$wine_clipboard_bridge_pid" ]] && printf active || printf unavailable)."

set +e
critical_pids=(
    "$xvfb_pid"
    "$openbox_pid"
    "$winlogon_pid"
    "$input_broker_pid"
    "$server_supervisor_pid"
)
for optional_pid in \
    "$manual_plane_pid" \
    "$grd_pid" \
    "$freerdp_pid" \
    "$desktop_x11vnc_pid" \
    "$vncviewer_pid" \
    "$x11_input_pid" \
    "$x11_clipboard_pid" \
    "$wine_clipboard_bridge_pid" \
    "$terminal_bridge_pid"; do
    if [[ -n "$optional_pid" ]]; then
        critical_pids+=("$optional_pid")
    fi
done
exited_pid=""
wait -n -p exited_pid "${critical_pids[@]}"
child_status=$?
set -e
log "A bridge process exited (pid=${exited_pid:-unknown}, status=$child_status); systemd will restart the complete relay."
exit 1
