preserve_cursor_guard_failure() {
    local phase="$1"
    local captured_at
    local evidence_dir
    local source
    local log_name

    captured_at="$(/usr/bin/date -u +%Y-%m-%dT%H:%M:%SZ)"
    if ! evidence_dir="$(/usr/bin/mktemp -d \
            "$state_dir/cursor-guard-failure.XXXXXXXX")"; then
        log "Cursor guard evidence could not be saved: time=$captured_at phase=$phase."
        return 1
    fi
    (
        umask 077
        printf 'time=%s\nphase=%s\nrelay_log=%s\nreader_log=%s\nmax_bytes_per_log=65536\n' \
            "$captured_at" "$phase" "$cursor_guard_log" \
            "$cursor_reader_guard_log" >"$evidence_dir/summary.txt"
        for source in "$cursor_guard_log" "$cursor_reader_guard_log" \
                "$state_dir/cursor-guard-injector.log" \
                "$state_dir/cursor-reader-guard-injector.log"; do
            if [[ -f "$source" && ! -L "$source" ]]; then
                case "$source" in
                    "$cursor_guard_log")
                        log_name=relay-guard.log ;;
                    "$cursor_reader_guard_log")
                        log_name=reader-guard.log ;;
                    *)
                        log_name="${source##*/}" ;;
                esac
                /usr/bin/tail -c 65536 "$source" >"$evidence_dir/$log_name" || exit 1
            else
                printf 'missing=%s\n' "$source" >>"$evidence_dir/summary.txt"
            fi
        done
    ) || return 1
    log "Cursor guard failure evidence saved: time=$captured_at phase=$phase path=$evidence_dir."
}

inject_input_bridge() {
    if ! /opt/wine-stable/bin/wine "$input_injector_exe" \
        "$input_bridge_windows_path" \
        >>"$state_dir/input-injector.log" 2>&1; then
        log 'Could not inject the UU input compatibility bridge.'
        return 1
    fi
}

initialize_server_compatibility() {
    local cursor_reader_guard_ready=false

    if [[ "$input_route" != rdp-public || "$public_input_ready" == true ]]; then
        inject_input_bridge || return 1
    fi
    [[ "$cursor_guard_setting" == on ]] || return 0
    rm -f "$cursor_reader_guard_log"
    if ! /opt/wine-stable/bin/wine "$input_injector_exe" \
        "$cursor_guard_windows_path" GameViewerServer.exe \
        >>"$state_dir/cursor-reader-guard-injector.log" 2>&1; then
        log 'Could not inject the UU cursor reader guard.'
        preserve_cursor_guard_failure reader-injection || true
        return 1
    fi
    cursor_reader_guard_ready=false
    for _ in {1..100}; do
        if grep -q 'UU cursor reader guard active' \
            "$cursor_reader_guard_log" 2>/dev/null; then
            cursor_reader_guard_ready=true
            break
        fi
        if grep -q 'UU cursor reader guard initialization failed' \
            "$cursor_reader_guard_log" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    if [[ "$cursor_reader_guard_ready" != true ]]; then
        log 'The UU cursor reader guard did not initialize.'
        preserve_cursor_guard_failure reader-readiness || true
        return 1
    fi
}

if [[ "$cursor_guard_setting" == on ]]; then
