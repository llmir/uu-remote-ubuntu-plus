relay_ready=false
if [[ "$desktop_relay" == rdp ]]; then
    freerdp_mouse_options=()
    freerdp_full_options=()
    freerdp_clipboard_option=+clipboard
    if [[ -n "$wine_clipboard_bridge_pid" ]]; then
        freerdp_clipboard_option=-clipboard
        log 'Native text/image clipboard owns synchronization; RDP CLIPRDR is disabled to avoid clipboard echo.'
    fi
    [[ "$input_route" != rdp-public ]] || freerdp_full_options+=(/dvc:uurb-full-input)
